{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/camera",
      "destination": "/camera/index.html"
    },
    {
      "source": "/camera/",
      "destination": "/camera/index.html"
    },
    {
      "source": "/customer",
      "destination": "/customer/index.html"
    },
    {
      "source": "/customer/",
      "destination": "/customer/index.html"
    },
    {
      "source": "/enter",
      "destination": "/enter/index.html"
    },
    {
      "source": "/enter/",
      "destination": "/enter/index.html"
    },
    {
      "source": "/demo",
      "destination": "/demo/index.html"
    },
    {
      "source": "/demo/",
      "destination": "/demo/index.html"
    },
    {
      "source": "/styleguide",
      "destination": "/styleguide/index.html"
    },
    {
      "source": "/styleguide/",
      "destination": "/styleguide/index.html"
    },
    {
      "source": "/presence",
      "destination": "/presence.html"
    },
    {
      "source": "/presence/",
      "destination": "/presence.html"
    },
    {
      "source": "/bottle",
      "destination": "/bottle.html"
    },
    {
      "source": "/bottle/",
      "destination": "/bottle.html"
    },
    {
      "source": "/shop",
      "destination": "/shop.html"
    },
    {
      "source": "/shop/",
      "destination": "/shop.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=()"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
