# SMARTSHELF Environment Configuration Template
# Copy this file to .env and configure strong values.

# Security & Authentication (Required)
APP_ENV=production
# Generate with: scripts\gen_secrets.bat
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-string
# Must be at least 8 characters and NOT '1234'
ADMIN_PIN=change-me-to-a-strong-pin-at-least-8-chars

# Network & Server
HOST=127.0.0.1
PORT=8000
# Public URL of the FastAPI backend (set this to your HTTPS tunnel hostname).
PUBLIC_BASE_URL=https://your-backend-host.example
# Vercel frontend origin must be explicitly allowed by backend CORS.
FRONTEND_PUBLIC_URL=https://frontend-rho-nine-46.vercel.app
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://frontend-rho-nine-46.vercel.app
STORE_OPEN=false
TRUST_PROXY=false

# System & Vision Settings
TOKEN_TTL_SECONDS=28800
ENTRY_TOKEN_TTL_SECONDS=30
SESSION_IDLE_TIMEOUT=900
STABLE_SECONDS=1.5
THRESHOLD_PRESENT=0.60
THRESHOLD_ABSENT=0.60
SIMILARITY_ALPHA=0.5

# Database URL
DB_URL=sqlite:///./data/smartshelf.db
# For Railway persistent volume: sqlite:////data/smartshelf.db
UPLOAD_DIR=./data/uploads

# SSL / HTTPS (Optional for local HTTPS)
USE_SSL=false
SSL_CERT_FILE=certs/cert.pem
SSL_KEY_FILE=certs/key.pem

# Phase 7: Product Recognition Engine
RECOGNITION_MODEL_PATH=ai/models/mobilenetv2-7.onnx
RECOGNITION_ACCEPT_THRESHOLD=0.65
RECOGNITION_MARGIN_THRESHOLD=0.08

# Portable object detector; brand-specific ONNX can be selected after training and evaluation.
BOTTLE_MODEL_PATH=ai/models/yolo26n.onnx
BOTTLE_DATASET_DIR=data/bottle_dataset

# Optional WebRTC ICE config (STUN default; add your own TURN for restricted NAT).
# RTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
